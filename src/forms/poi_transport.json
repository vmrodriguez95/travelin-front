            {
              "value": "flight",
              "label": "Vuelo"
            },
            {
              "value": "cruise",
              "label": "Crucero"
            },
            {
              "value": "ferry",
              "label": "Barco"
            },
            {
              "value": "train",
              "label": "Tren"
            },
            {
              "value": "bus",
              "label": "Autobús"
            },
            {
              "value": "car",
              "label": "Coche"
            }
          ],
          "required": true,
          "readonly": false
        }
      }
    },
    "booking": {
