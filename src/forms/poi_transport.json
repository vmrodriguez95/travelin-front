[{
  "form": {
    "entity": "poi_transport",
    "method": "POST",
    "action": "create"
  },
  "sections": {
    "core": {
      "legend": "Datos principales",
      "removeMainKey": true,
      "fields": {
        "order": {
          "id": "poiTransportOrder",
          "name": "order",
          "label": "Orden",
          "type": "hidden",
          "fillValue": 0,
          "required": false,
          "readonly": false
        },
        "name": {
          "id": "poiTransportName",
          "name": "name",
          "label": "Nombre para el transporte",
          "type": "text",
          "required": false,
          "readonly": false
        },
        "file": {
          "id": "poiTransportFile",
          "name": "file",
          "label": "Archivo",
          "file": {
            "extensions": ".pdf",
            "maxSize": 521000,
            "multiple": false
          },
          "type": "file",
          "required": false,
          "readonly": false
        },
        "type": {
          "id": "poiTransportType",
          "name": "type",
          "label": "Tipo de transporte",
          "type": "select",
          "options": [
            {
              "value": "flight",
              "label": "Vuelo"
            },
            {
              "value": "cruise",
              "label": "crucero"
            },
            {
              "value": "ferry",
              "label": "barco"
            },
            {
              "value": "train",
              "label": "Tren"
            },
            {
              "value": "bus",
              "label": "Autobús"
            },
            {
              "value": "car",
              "label": "coche"
            }
          ],
          "required": true,
          "readonly": false
        }
      }
    },
    "booking": {
      "legend": "Datos sobre la reserva",
      "fields": {
        "reference": {
          "id": "poiTransporBookingReference",
          "name": "reference",
          "label": "Referencia de la reserva",
          "helpmsg": "Hace referencia al PNR o localizador de la reserva",
          "type": "text",
          "required": false,
          "readonly": false
        },
        "ticketNumber": {
          "id": "poiTransporBookingTicketNumber",
          "name": "ticketNumber",
          "label": "Número del ticket",
          "type": "text",
          "required": false,
          "readonly": false
        },
        "provider": {
          "id": "poiTransporBookingProvider",
          "name": "provider",
          "label": "Plataforma/proveedor de la reserva",
          "type": "text",
          "required": false,
          "readonly": false
        },
        "price": {
          "id": "poiTransporBookingPrice",
          "name": "price",
          "label": "Coste de la reserva",
          "type": "text",
          "required": false,
          "readonly": false
        },
        "currency": {
          "id": "poiTransporBookingCurrency",
          "name": "currency",
          "label": "Tipo de moneda",
          "type": "select",
          "options": [],
          "required": false,
          "readonly": false
        }
      }
    },
    "segments": {
      "sectionTitle": "Trayectos",
      "schema": {
        "origin": {
          "sectionTitle": "Origen",
          "fields": {
            "code": {
              "id": "poiTransportSegmentsCode",
              "name": "code",
              "label": "Código IATA del origen",
              "type": "text",
              "required": false,
              "readonly": false
            },
            "name": {
              "id": "poiTransportSegmentsName",
              "name": "name",
              "label": "Aeropuerto, puerto, estación... de origen",
              "type": "text",
              "required": false,
              "readonly": false
            },
            "city": {
              "id": "poiTransportSegmentsCity",
              "name": "city",
              "label": "Ciudad",
              "type": "text",
              "required": false,
              "readonly": false
            },
            "country": {
              "id": "poiTransportSegmentsCountry",
              "name": "country",
              "label": "País",
              "type": "text",
              "required": false,
              "readonly": false
            },
            "date": {
              "id": "poiTransportSegmentsDate",
              "name": "date",
              "label": "Elige las fecha del vuelo",
              "type": "date",
              "fieldSize": "full",
              "required": false,
              "readonly": false
            }
          }
        }
      }
    },
    "passengers": {
      "sectionTitle": "Pasajeros",
      "schema": [
        {
          "name": {
            "id": "poiTransportPassengersName",
            "name": "name",
            "label": "Nombre",
            "type": "text",
            "required": false,
            "readonly": false
          }
        }
      ]
    }
  }
}]