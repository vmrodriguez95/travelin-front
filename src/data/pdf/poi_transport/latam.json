{
  "id": "latam",
  "match": ["latam airlines group", "89.862.200-2"],
  "poiType": "poi_transport",
  "typeTransport": "flight",
  "provider": "LATAM Airlines",
  "passengers": {
    "within": { "page": 0 },
    "after": "Nombre Pasajero",
    "until": ["Itinerario"],
    "name": { "column": 0, "transform": "collapseSpaces" }
  },
  "price": { "regex": "Total pagado\\t\\s*\\$?\\s*([\\d.,]+)" },
  "segments": {
    "perRow": true,
    "within": { "page": 0 },
    "startsAt": "^LA\\s?\\d{3,}",
    "transportNumber": { "regex": "^(LA\\s?\\d{3,})", "within": { "xMax": 0.13 }, "transform": "collapseSpaces" },
    "class": {
      "concat": [
        { "regex": "([\\s\\S]+)", "within": { "xMin": 0.65, "xMax": 0.75 }, "transform": "collapseSpaces" },
        { "regex": "([\\s\\S]+)", "within": { "xMin": 0.75, "xMax": 0.85 }, "transform": "collapseSpaces" }
      ]
    },
    "seat": { "regex": "([\\s\\S]+)", "within": { "xMin": 0.85 }, "transform": "collapseSpaces" },
    "origin": {
      "name": { "regex": "([\\s\\S]+)", "within": { "xMin": 0.13, "xMax": 0.23 }, "transform": "collapseSpaces" },
      "date": { "regex": "([\\s\\S]+)", "within": { "xMin": 0.33, "xMax": 0.41 }, "transform": "collapseSpaces" },
      "time": { "regex": "(\\d{1,2}:\\d{2})", "within": { "xMin": 0.41, "xMax": 0.49 } }
    },
    "destiny": {
      "name": { "regex": "([\\s\\S]+)", "within": { "xMin": 0.23, "xMax": 0.33 }, "transform": "collapseSpaces" },
      "date": { "regex": "([\\s\\S]+)", "within": { "xMin": 0.49, "xMax": 0.56 }, "transform": "collapseSpaces" },
      "time": { "regex": "(\\d{1,2}:\\d{2})", "within": { "xMin": 0.56, "xMax": 0.65 } }
    }
  }
}
