---
const { id, name, label, helpmsg, options, value, canAdd, addLabel, nameLabel, namePlaceholder } = Astro.props
---

<e-checkbox-group data-component id={id} name={name} label={label} helpmsg={helpmsg} options={options} value={value} canAdd={canAdd} addLabel={addLabel} nameLabel={nameLabel} namePlaceholder={namePlaceholder} />
