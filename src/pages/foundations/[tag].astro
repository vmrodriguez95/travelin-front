---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { foundations } from '../../registry/foundations'

const { tag } = Astro.params
const foundation = foundations.find((f) => f.meta.tag === tag)
if (!foundation) {
  throw new Error(`Foundation ${tag} not found`)
}

const Demo = foundation.Demo
const config = foundation.config

// === Astro necesita esto para build-time ===
export async function getStaticPaths() {
  return foundations.map(c => ({ params: { tag: c.meta.tag } }))
}
---

<BaseLayout>
  <h1>{foundation.meta.name}</h1>
  <p>{foundation.meta.description}</p>
  <Demo />
</BaseLayout>