---
import BaseLayout from '@ds/layouts/BaseLayout.astro'
import { foundations } from '@ds/registry/foundations'

const { tag } = Astro.params
const foundation = foundations.find((f) => f.meta.tag === tag)
if (!foundation) {
  throw new Error(`foundation ${tag} not found`)
}

const Demo = foundation.Demo

// === Astro necesita esto para build-time ===
export async function getStaticPaths() {
  return foundations.map((e) => ({ params: { tag: e.meta.tag } }))
}
---

<BaseLayout>
  <h1>{foundation.meta.name}</h1>
  <p>{foundation.meta.description}</p>

  <h2>Preview</h2>
  <Demo />
</BaseLayout>