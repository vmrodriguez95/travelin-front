---
// === Imports ===
import BaseLayout from '@web/layouts/BaseLayout.astro'

import Code from '@web/components/code/Code.astro'
import Config from '@web/components/config/Config.astro'

import { components } from '@web/registry/components'

import { getAttrs } from '@web/utils/utils'

// === Get component data ===
const { tag } = Astro.params
const component = components.find((c) => c.meta.tag === tag)

if (!component) {
  throw new Error(`Component ${tag} not found`)
}

const Demo = component.Demo
const config = component.config

export async function getStaticPaths() {
  return components.map((c) => ({ params: { tag: c.meta.tag } }))
}
---

<BaseLayout>
  <h1 class="ti-text--xl">{component.meta.name}</h1>
  <p class="ti-text--m">{component.meta.description}</p>

  <h2 class="ti-text--l">Demo</h2>
  <Demo id="component" {...getAttrs(component)}>{config.slots?.default?.default}</Demo>

  <section class="u-grid ti-border-top ti-margin-top--xl ti-padding-top--xl">
    {Object.keys(config.props).length > 0 && 
      <div class="u-col-4 u-col-md-6">
        <Config config={config} />
      </div>
      <div class="u-col-4 u-col-md-6">
        <Code />
      </div>
    }

    {Object.keys(config.props).length === 0 &&
      <div class="u-col-4 u-col-md-12">
        <Code />
      </div>
    }
  </section>
</BaseLayout>
