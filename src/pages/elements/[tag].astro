---
import BaseLayout from '@web/layouts/BaseLayout.astro'

import Code from '@web/components/code/Code.astro'
import Config from '@web/components/config/Config.astro'

import { elements } from '@web/registry/elements'
import { getAttrs } from '@web/utils/utils'

const { tag } = Astro.params
const element = elements.find((e) => e.meta.tag === tag)

if (!element) {
  throw new Error(`Element ${tag} not found`)
}

const Demo = element.Demo
const config = element.config

export async function getStaticPaths() {
  return elements.map((e) => ({ params: { tag: e.meta.tag } }))
}
---

<BaseLayout>
  <h1 class="ti-text--xl">{element.meta.name}</h1>
  <p class="ti-text--m">{element.meta.description}</p>

  <h2 class="ti-text--l">Demo</h2>
  <Demo {...getAttrs(element)}>{config.slots?.default?.default}</Demo>

  <section class="u-grid ti-border-top ti-margin-top--xl ti-padding-top--xl">
    {Object.keys(config.props).length > 0 && 
      <div class="u-col-4 u-col-md-6">
        <Config config={config} />
      </div>
      <div class="u-col-4 u-col-md-6">
        <Code />
      </div>
    }

    {Object.keys(config.props).length === 0 &&
      <div class="u-col-4 u-col-md-12">
        <Code />
      </div>
    }
  </section>
</BaseLayout>
