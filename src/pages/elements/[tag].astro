---
import BaseLayout from '@ds/layouts/BaseLayout.astro'
import ConfigLayout from '@ds/layouts/ConfigLayout.astro'
import { elements } from '@ds/registry/elements'

const { tag } = Astro.params
const element = elements.find((e) => e.meta.tag === tag)

if (!element) {
  throw new Error(`Element ${tag} not found`)
}

const Demo = element.Demo
const config = element.config

// === Astro necesita esto para build-time ===
export async function getStaticPaths() {
  return elements.map((e) => ({ params: { tag: e.meta.tag } }))
}
---

<BaseLayout>
  <h1>{element.meta.name}</h1>
  <p>{element.meta.description}</p>

  <h2>Preview</h2>
  <Demo />

  <hr />

  <h2>Config</h2>
  <ConfigLayout config={config} />
</BaseLayout>