---
import { getIcon } from '@web/registry/icons'
---

<section class="ti-code">
  <h2 class="ti-code__title ti-text--xl">Código</h2>
  <pre class="ti-code__block">
    <code id="code-output" class="ti-code__output language-xml"></code>
  </pre>
  <button class="ti-code__copy" data-action="copy-code">Copiar código <span class="ti-code__icon ti-icon" set:html={getIcon('copy')}></span></button>
</section>

<script>
  import hljs from 'highlight.js/lib/core'
  import xml from 'highlight.js/lib/languages/xml'

  import { showToast } from '@web/components/toast/toast.script.ts'
  import { prettyHTML } from '@web/utils/utils.ts'

  hljs.registerLanguage('xml', xml)

  const component = document.querySelector('[data-component]')
  const codeEl = document.querySelector('#code-output') as HTMLElement
  const buttonCopy = document.querySelector('[data-action="copy-code"]')

  if (!component) throw new Error('Component not found')
  
  function updateCode() {
    if (!component || !codeEl) return

    const content = component.innerHTML.trim()
    const inner = content ? ` ${content} ` : ''

    const tagName = component.tagName.toLowerCase()
    const attrs = Array.from(component.attributes)
      .filter((attr) => {
        return attr.name !== 'data-component' // omitimos el atributo data-component
      })
      .map((attr) => {
        if (attr.value === '') return attr.name
        return `${attr.name}="${attr.value}"`
      })
      .join(' ')

    const openTag = attrs.length
      ? `<${tagName} ${attrs}>`
      : `<${tagName}>`

    const finalContent = `${openTag}${inner}</${tagName}>`

    codeEl.textContent = prettyHTML(finalContent)

    hljs.highlightElement(codeEl)
  }

  function copyCode() {
    if (!codeEl) return
    navigator.clipboard.writeText(codeEl.textContent || '').then(() => {
      showToast('Código copiado al portapapeles', 'success')
    }).catch(() => {
      showToast('Error al copiar el código', 'error')
    })
  }

  function attachCopyListeners() {
    if (!buttonCopy) return
    buttonCopy.addEventListener('click', copyCode)
  }

  
  // inicial
  updateCode()
  attachCopyListeners()

  // observar cambios de atributos
  const observer = new MutationObserver(updateCode)
  observer.observe(component, {
    attributes: true,
    childList: true,
    subtree: true
  })
</script>
