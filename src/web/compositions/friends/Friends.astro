---
import AppMenu from '@web/components/AppMenu.astro'
import type { Friend } from '@ds/components/c-friends-list/c-friends-list.types.ts'

const filters = JSON.stringify([
  {
    label: 'Todas',
    value: '',
    icon: 'grid',
    default: true
  },
  {
    label: 'Invitaciones',
    value: 'invitations',
    icon: 'mail'
  },
  {
    label: 'Viajes',
    value: 'travel',
    icon: 'flight'
  },
  {
    label: 'Avisos',
    value: 'alerts',
    icon: 'alert'
  }
])

const friends: Friend[] = [
  {
    image: 'https://testingbot.com/free-online-tools/random-avatar/40',
    name: 'Daniel Fernández',
    date: '10-10-2023',
    lastTravel: 'Costa Rica · 2024',
    status: 'Activo'
  },
  {
    image: 'https://testingbot.com/free-online-tools/random-avatar/40',
    name: 'Daniel Fernández',
    date: '10-10-2023',
    lastTravel: 'Costa Rica · 2024',
    status: 'Pendiente'
  },
  {
    image: 'https://testingbot.com/free-online-tools/random-avatar/40',
    name: 'Daniel Fernández',
    date: '10-10-2023',
    lastTravel: 'Costa Rica · 2024',
    status: 'Activo'
  }
]

---

<section class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <c-header heading="Amigos" url="#" backA11y="Volver atrás"></c-header>
    <div class="ti-friends">
      <c-filter filters={ filters } api="/api/friends.json" placeholder="Busca un amigo"></c-filter>
      <c-friends-list>
        <ul class="ti-friends__list">
          {
            friends.map((friend) => (
            <li class="ti-friends__item">
              <div class="ti-friend-item">
                <div class="ti-friend-item__head">
                  {
                    friend.image && (
                      <picture class="ti-friend-item__image">
                        <img class="u-image--responsive" src={ friend.image } alt="Logo" width="40" height="40" />
                      </picture>
                    )
                  }
                  <span class="ti-friend-item__text">{ friend.name }</span>
                </div>
                <p class="ti-friend-item__date">{ friend.date }</p>
                <p class="ti-friend-item__text"><small class="ti-friend-item__small">Último viaje juntos:</small> { friend.lastTravel }</p>
                <p class="ti-friend-item__text"><span class="ti-friend-item__status ti-friend-item__status--green"></span> { friend.status }</p>
                <div class="ti-friend-item__actions">
                  <e-fetch action="/api/poi.json" method="DELETE" icon="delete" color="dark" size="fit">
                    <e-icon icon="delete" size="m"></e-icon>
                  </e-fetch>
                </div>
              </div>
            </li>
            ))
          }
        </ul>
      </c-friends-list>
    </div>
  </div>
</section>
