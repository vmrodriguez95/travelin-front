---
import AppMenu from '@web/components/AppMenu.astro'
import { withFormA11yDefaults } from '@web/utils/form.server.ts'
const { id, data } = Astro.props
const channel = 'new-poi'

let finalData = withFormA11yDefaults(data)

finalData.sections.core.fields.location.api = '/api/places.json'

finalData = JSON.stringify(finalData)
---

<section id={id} class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <div class="ti-form">
      <div class="ti-form__map">
        <a href="#" class="ti-form__back">
          <e-icon icon="arrow-left" size="l"></e-icon>
        </a>
        <e-input-search class="ti-form__search" id="search" api="/api/places.json" places="/api/poi.json" name="search" placeholder="Busca un POI" channel={channel}></e-input-search>
        <c-map latitude="13.0389969" longitude="101.490104" zoom="5" fullheight="auto"></c-map>
        <c-poi-resume channel={channel} close="Cerrar" icon="add" button="Añadir" info="Abrir formulario para añadir el nuevo POI" />
      </div>
    </div>
  </div>
</section>
<c-modal id="modal" close="Cerrar">
  <c-form action="/" method="POST" data={finalData} submitLabel="Añadir POI" enctype="multipart/form-data"></c-form>
</c-modal>
