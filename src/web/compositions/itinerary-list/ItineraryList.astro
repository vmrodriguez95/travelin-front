---
import AppMenu from '@web/components/AppMenu.astro'
import { withFormA11yDefaults } from '@web/utils/form.server.ts'
const { id, data } = Astro.props

const finalData = withFormA11yDefaults(data)
---

<main id={id} class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <c-header
      heading="TAILANDIA"
      subheading="12-05-2024 / 26-05-2024"
      complement="1 adulto"
      url="#"
      bg="https://loremflickr.com/2000/600/tailand"
      openA11y="Abrir menú de acciones para el viaje"
      backA11y="Ir a la página de todos los viajes"
    >
      <a href="#" title="Ir a la página para ver todos los documentos del viaje">
        <span class="u-pin-icon u-pin-icon--s u-pin-icon--hover">
          <e-icon icon="cards" size="m"></e-icon>
        </span>
      </a>
      <e-modal-trigger>
        <span class="u-pin-icon u-pin-icon--s u-pin-icon--hover">
          <e-icon icon="group" size="m"></e-icon>
        </span>
      </e-modal-trigger>
      <a href="#" title="Ir a la página para ver todos los gastos del viaje">
        <span class="u-pin-icon u-pin-icon--s u-pin-icon--hover">
          <e-icon icon="money" size="m"></e-icon>
        </span>
      </a>
      <e-modal-trigger>
        <span class="u-pin-icon u-pin-icon--s u-pin-icon--hover">
          <e-icon icon="share" size="m"></e-icon>
        </span>
      </e-modal-trigger>
      <e-modal-trigger modal="modal">
        <span class="u-pin-icon u-pin-icon--s u-pin-icon--hover">
          <e-icon icon="delete" size="m"></e-icon>
        </span>
        <template>
          <h2 slot="title">Eliminar viaje</h2>
          <p slot="description">Estas a punto de eliminar este viaje. Si lo eliminas, perderás todos los archivos e información adjunta al viaje y no habrá vuelta atrás. ¿Realmente estás seguro de que quieres eliminarlo?</p>
          <c-form action="/" method={finalData.form.method} type={finalData.form.action} data={JSON.stringify(finalData)} submitLabel="Eliminar viaje"></c-form>
        </template>
      </e-modal-trigger>
    </c-header>
    <section class="ti-itinerary-list">
      <c-swipe class="u-col-4 u-col-md-12 u-col-xl-5 ti-itinerary-list__dates-column" action="Desliza hacia arriba o hacia abajo para ocultar o mostrar el mapa respectivamente.">
        <div class="ti-itinerary-list__dates-list">
          {Array.from({ length: 15 }, (_, i) => (
            <a class="u-link--no-underline" href="#" title="Ir al itinerario del día 03-03-2026">
              <c-card-date class="u-margin--bottom--m" text="Llegada a Bangkok">
                <p slot="index">Día {i + 1}</p>
                <p slot="day">{3 + i}</p>
                <p slot="month">Marzo</p>
                <ul>
                  <li class="u-flex u-flex--align--center u-margin--bottom--s">
                    <span class="u-pin-icon u-pin-icon--s">
                      <e-icon icon="flight" size="s"></e-icon>
                    </span>
                    <p class="u-margin--none u-text--ellipsis">9:00 AM - Aterrizaje en Bangkok</p>
                  </li>
                  <li class="u-flex u-flex--align--center u-margin--bottom--s">
                    <span class="u-pin-icon u-pin-icon--s">
                      <e-icon icon="hotel" size="s"></e-icon>
                    </span>
                    <p class="u-margin--none u-text--ellipsis">9:00 AM - Aterrizaje en Bangkok</p>
                  </li>
                  <li class="u-flex u-flex--align--center">
                    <span class="u-pin-icon u-pin-icon--s">
                      <e-icon icon="monument" size="s"></e-icon>
                    </span>
                    <p class="u-margin--none u-text--ellipsis">Khao Sand Road</p>
                  </li>
                </ul>
              </c-card-date>
            </a>
          ))}
        </div>
      </c-swipe>
      <div class="ti-itinerary-list__content u-col-4 u-col-md-12 u-col-xl-7">
        <c-map latitude="13.0389969" longitude="101.490104" zoom="5" fullheight="auto"></c-map>
      </div>
    </section>
  </div>
</main>
<c-modal id="modal" close="Cerrar"></c-modal>
