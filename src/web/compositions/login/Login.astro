---
import { withFormA11yDefaults } from '@web/utils/form.server.ts'
const { id, data } = Astro.props

let finalData = withFormA11yDefaults(data)

finalData.sections.core.fields._username.a11y = {
  clear: "Eliminar valor del campo"
}

finalData.sections.core.fields._password.a11y = {
  clear: "Eliminar valor del campo",
  showPassword: "Mostrar contraseña",
  hidePassword: "Ocultar contraseña"
}

finalData = JSON.stringify(finalData)
---

<section id={id} class="u-padding--l u-bg--dark" data-component>
  <img src="/images/logo-text.png" alt="Logo" width="244" height="66" />
  <div class="u-grid">
    <div class="u-col-4 u-col-md-2 u-col-lg-3 u-col-xl-4"></div>
    <div class="u-col-4 u-col-md-8 u-col-lg-6 u-col-xl-4">
      <c-form action="/" method="POST" data={finalData} submitLabel="Login"></c-form>
      <div class="u-text--center">
        <p class="u-text--m u-color--text-light">¿Has olvidado la contraseña? <a class="u-link" href="/simulator/forget">Clica aquí</a></p>
        <p class="u-separator"><span class="u-separator__text">o</span></p>
        <e-fetch class="u-margin--bottom--m" action="#" method="POST" color="dark">
          <img src="/images/logo-google.png" alt="Logo de Google" width="24" height="24" loading="lazy"/> Inicia sesión con Google
        </e-fetch>
        <e-fetch action="#" method="POST" color="dark">
          <img src="/images/logo-apple.png" alt="Logo de Apple" width="24" height="24" loading="lazy"/> Inicia sesión con tu ID de Apple
        </e-fetch>
        <p class="u-text--l u-color--text-light">¿No tienes cuenta? <a class="u-link" href="/simulator/register">Regístrate</a></p>
      </div>
    </div>
    <div class="u-col-4 u-col-md-2 u-col-lg-3 u-col-xl-4"></div>
  </div>
</section>
