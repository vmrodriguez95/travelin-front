---
const { id } = Astro.props
---

<main id={id} class="u-padding--l u-bg--dark" data-component>
  <img src="/images/logo-text.png" alt="Logo" width="244" height="66" />
  <div class="u-grid">
    <div class="u-col-4 u-col-md-2 u-col-lg-3 u-col-xl-4"></div>
    <div class="u-col-4 u-col-md-8 u-col-lg-6 u-col-xl-4">
      <c-verify action="" method="POST" submitLabel="Verificar">
        <h2 slot="title">Verifica tu cuenta</h2>
        <p slot="description">Te hemos enviado un email con el código de verificación que deberás introducir a continuación</p>

        <p>¿No has recibido el código? No te preocupes, te lo enviamos de nuevo</p>
        <e-fetch action="#" method="POST" type="link" wait="10000" waitmsg="El enlace se activará en">
          <span>Reenviar código</span>
        </e-fetch>
      </c-verify>
    </div>
    <div class="u-col-4 u-col-md-2 u-col-lg-3 u-col-xl-4"></div>
  </div>
</main>