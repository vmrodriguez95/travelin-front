---
import { Temporal } from '@js-temporal/polyfill'
import { getAllData } from '@web/utils/data.utils.ts'

const { id } = Astro.props
const data = getAllData()

function printHotelDates(start: string, end: string) {
  const startDate = Temporal.PlainDate.from(start)
  const endDate = Temporal.PlainDate.from(end)

  return `${startDate.day} - ${endDate.day} ${endDate.toLocaleString('es', { month: 'short' })}`
}

