---
import AppMenu from '@web/components/AppMenu.astro'
import type { Poi, PoiHotel, PoiTransport, Reminder, Note } from '@ds/types/pois'

type AnyPoi = Poi | PoiHotel | PoiTransport | Reminder | Note

const { id } = Astro.props

const buttons = [
  {
    label: 'Transporte',
    icon: 'transport',
  },
  {
    label: 'Alojamiento',
    icon: 'hotel',
  },
  {
    label: 'POI',
    icon: 'location',
  },
  {
    label: 'Recordatorio',
    icon: 'reminder',
  },
  {
    label: 'Archivo',
    icon: 'attach-file',
  },
  {
    label: 'Guardados',
    icon: 'bookmark',
  },
]

const poisGlob = import.meta.glob('../../../data/pois.json', { eager: true })
const pois: AnyPoi[] = (Object.values(poisGlob)[0] as { default: AnyPoi[] })?.default ?? []
const channel = 'poi-list'
const googleMapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || import.meta.env.VITE_GOOGLE_MAPS_API_KEY || ''

function getMarkerView(type: string) {
  return type === 'poi' || type === 'poi_hotel' ? 'resume' : 'detail'
}

const markers = pois.flatMap((poi: any) => {
  if (Array.isArray(poi.coordinates)) {
    return [{
      id: poi.id,
      idPoi: poi.id,
      label: poi.name,
      type: poi.type,
      coordinates: poi.coordinates,
      icon: poi.icon || 'location',
      data: poi,
      view: getMarkerView(poi.type)
    }]
  }

  if (poi.type === 'poi_transport' && Array.isArray(poi.segments)) {
    return poi.segments.flatMap((segment: any, index: number) => {
      const segmentMarkers = []

      if (Array.isArray(segment.origin?.coordinates)) {
        segmentMarkers.push({
          id: `${poi.id}-origin-${index}`,
          idPoi: poi.id,
          label: `${poi.name} - ${segment.origin.code}`,
          type: poi.type,
          coordinates: segment.origin.coordinates,
          icon: poi.typeTransport || 'transport',
          data: poi,
          view: getMarkerView(poi.type)
        })
      }

      if (Array.isArray(segment.destiny?.coordinates)) {
        segmentMarkers.push({
          id: `${poi.id}-destiny-${index}`,
          idPoi: poi.id,
          label: `${poi.name} - ${segment.destiny.code}`,
          type: poi.type,
          coordinates: segment.destiny.coordinates,
          icon: poi.typeTransport || 'transport',
          data: poi,
          view: getMarkerView(poi.type)
        })
      }

      return segmentMarkers
    })
  }

  return []
})

function formatDate(dateStart: string, dateEnd: string) {
  const start = new Date(dateStart)
  const end = new Date(dateEnd)

  const formattedStart = start.toLocaleDateString('es-ES', { day: '2-digit' })
  const formattedEnd = end.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' })

  return `${formattedStart} - ${formattedEnd}`
}
---

<section id={id} class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <c-header heading="Itinerary" subheading="12-05-2024" url="#" bg="https://loremflickr.com/2000/600/thailand" animated backA11y="Volver atrás"></c-header>
    <section class="u-grid u-padding--top--xl ti-poi-list">
      <div class="u-col-4 u-col-md-12 u-border--bottom u-scroll--horizontal ti-poi-list__dates">
        {Array.from({ length: 15 }, (_, i) => (
          <a href="#" title={`Ir al día ${i + 1}`} class="u-date">
            <p class="u-date__date">{12 + i} May</p>
            <p class="u-date__day">Día {12 + i}</p>
          </a>
        ))}
      </div>
      <div class="u-col-4 u-col-md-12 u-col-lg-6 ti-poi-list__panel">
        <div class="u-flex u-scroll--horizontal ti-poi-list__toolbar">
          {buttons.map((button) => (
            <a href="#" class="u-link-icon">
              <e-icon icon={button.icon} size="m"></e-icon>
              <span class="u-link-icon__text">{button.label}</span>
            </a>
          ))}
        </div>
        <div class="u-scroll--vertical ti-poi-list__cards">
          {pois.map((poi: any) => (
            poi.type == 'poi_transport' ? (
              <c-card-transport class="u-margin--bottom--m" icon={poi.typeTransport} data={JSON.stringify(poi)} channel={channel}>
                <a href="#" slot="action">
                  <e-icon icon="edit" size="m"></e-icon>
                </a>
                <e-modal-trigger modal="modal" slot="action">
                  <e-icon icon="delete" size="m"></e-icon>
                  <template>
                    <h2 slot="title">Eliminar {poi.name}</h2>
                    <p slot="description">Estas a punto de eliminar este transporte del listado. ¿Estás seguro de que quieres quitarlo?</p>
                    <e-fetch action="/api/poi.json" method="DELETE">
                      <span>Eliminar</span>
                    </e-fetch>
                  </template>
                </e-modal-trigger>
              </c-card-transport>
            ) : (
              <c-card-poi class="u-margin--bottom--m" icon={poi.icon} data={JSON.stringify(poi)} type={poi.type} channel={channel}>
                {
                  poi.image && (
                    <img {...{ slot: 'img' }} src={poi.image} alt={`Picture about ${poi.name}`} width="64" height="64" loading="lazy" />
                  )
                }
                <span slot="title">{poi.name}</span>
                <span slot="description">{poi.price}</span>
                <span slot="date">{poi.time || formatDate(poi.dateStart, poi.dateEnd)}</span>
                <a href="#" slot="action">
                  <e-icon icon="edit" size="m"></e-icon>
                </a>
                <e-modal-trigger modal="modal" slot="action">
                  <e-icon icon="delete" size="m"></e-icon>
                  <template>
                    <h2 slot="title">Eliminar {poi.name}</h2>
                    <p slot="description">Estas a punto de eliminar este elemento del listado. Si lo tienes en tus guardados, no te preocupes, no se eliminará de ahí. ¿Quieres quitarlo de este itinerario?</p>
                    <e-fetch action="/api/poi.json" method="DELETE">
                      <span>Eliminar</span>
                    </e-fetch>
                  </template>
                </e-modal-trigger>
              </c-card-poi>
            )
          ))}
        </div>
      </div>
      <div class="u-col-4 u-col-md-12 u-col-lg-6 ti-poi-list__map-column">
        <div class="u-pos--relative ti-poi-list__map">
          <c-map apiKey={googleMapsApiKey} markers={JSON.stringify(markers)} fullheight="auto" channel={channel}></c-map>
          <c-poi-detail channel={channel} close="Cerrar" />
          <c-poi-resume channel={channel} close="Cerrar" info="Mostrar la información completa sobre el punto de interés" />
        </div>
      </div>
    </section>
  </div>
</section>
<c-modal id="modal" close="Cerrar"></c-modal>
<e-notification channel={channel} timeout="2">
  <span>POI eliminado correctamente</span>
</e-notification>
