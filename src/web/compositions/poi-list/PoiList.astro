---
const { id } = Astro.props

const buttons = [
  {
    label: 'Transporte',
    icon: 'transport',
  },
  {
    label: 'Alojamiento',
    icon: 'hotel',
  },
  {
    label: 'POI',
    icon: 'location',
  },
  {
    label: 'Recordatorio',
    icon: 'reminder',
  },
  {
    label: 'Archivo',
    icon: 'attach-file',
  },
  {
    label: 'Guardados',
    icon: 'bookmark',
  },
]

const poisGlob = import.meta.glob('../../../data/pois.json', { eager: true })
const pois = (Object.values(poisGlob)[0] as any)?.default

function formatDate(dateStart: string, dateEnd: string) {
  const start = new Date(dateStart)
  const end = new Date(dateEnd)

  const formattedStart = start.toLocaleDateString('es-ES', { day: '2-digit' })
  const formattedEnd = end.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' })

  return `${formattedStart} - ${formattedEnd}`
}
---

<section id={id} class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <c-menu>
      <a slot="logo" href="#">
        <img src="/images/logo.png" alt="Logo" width="42" height="48">
      </a>
      <li slot="links" class="active">
        <a href="#" title="Ir a home">
          <e-icon icon="home" size="l"></e-icon>
        </a>
      </li>
      <li slot="links">
        <a href="#" title="Ir a viajes">
          <e-icon icon="map" size="l"></e-icon>
        </a>
      </li>
      <li slot="links">
        <a href="#" title="Ir a configuración">
          <e-icon icon="settings" size="l"></e-icon>
        </a>
      </li>
      <li slot="links">
        <a href="#" title="Ir a usuarios">
          <e-icon icon="person" size="l"></e-icon>
        </a>
      </li>
      <li slot="links">
        <a href="#" title="Ir a viajes destacados">
          <e-icon icon="bookmark" size="l"></e-icon>
        </a>
      </li>
      <a slot="profile" href="#">
        <img src="https://testingbot.com/free-online-tools/random-avatar/40" alt="Avatar" width="40" height="40">
      </a>
    </c-menu>
  </div>
  <div class="u-grid-main--main">
    <c-header heading="Itinerary" subheading="12-05-2024" url="#" bg="https://loremflickr.com/2000/600/thailand"></c-header>
    <section class="u-grid u-padding--top--xl">
      <div class="u-col-4 u-col-md-12 u-border--bottom u-scroll--horizontal">
        {Array.from({ length: 15 }, (_, i) => (
          <a href="#" title={`Ir al día ${i + 1}`} class="u-date">
            <p class="u-date__date">{12 + i} May</p>
            <p class="u-date__day">Día {12 + i}</p>
          </a>
        ))}
      </div>
      <div class="u-col-4 u-col-md-12 u-col-lg-6">
        <div class="u-flex u-scroll--horizontal u-margin--bottom--l u-padding--vertical--s">
          {buttons.map((button) => (
            <a href="#" class="u-link-icon">
              <e-icon icon={button.icon} size="m"></e-icon>
              <span class="u-link-icon__text">{button.label}</span>
            </a>
          ))}
        </div>
        {pois.map((poi: any) => (
          poi.types?.includes('transport') ? (
            <c-card-transport class="u-margin--bottom--m" icon={poi.type} data={JSON.stringify(poi)} />
          ) : (
            <c-card-poi class="u-margin--bottom--m" icon={poi.icon} data={JSON.stringify(poi)}>
              {
                poi.image && (
                  <img {...{ slot: 'img' }} src={poi.image} alt={`Picture about ${poi.name}`} width="80" height="80" loading="lazy" />
                )
              }
              <span slot="title">{poi.name}</span>
              <span slot="description">{poi.price}</span>
              <span slot="date">{poi.time || formatDate(poi.dateStart, poi.dateEnd)}</span>
            </c-card-poi>
          )
        ))}
      </div>
      <div class="u-col-4 u-col-md-12 u-col-lg-6 u-pos--relative">
        <c-map fullheight latitude="40.7127837" longitude="-74.0059413" api="/api/places.json"></c-map>
        <c-poi-detail />
      </div>
    </section>
  </div>
</section>