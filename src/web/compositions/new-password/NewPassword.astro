---
const { id, data } = Astro.props

let finalData = data

finalData.sections.core.fields.password.a11y = {
  clear: "Eliminar valor del campo",
  showPassword: "Mostrar contraseña",
  hidePassword: "Ocultar contraseña"
}

finalData.sections.core.fields.repeatPassword.a11y = {
  clear: "Eliminar valor del campo",
  showPassword: "Mostrar contraseña",
  hidePassword: "Ocultar contraseña"
}

finalData = JSON.stringify(finalData)
---

<section id={id} class="u-padding--l u-bg--dark" data-component>
  <img src="/images/logo-text.png" alt="Logo" width="244" height="66" />
  <div class="u-grid">
    <div class="u-col-4 u-col-md-2 u-col-lg-3 u-col-xl-4"></div>
    <div class="u-col-4 u-col-md-8 u-col-lg-6 u-col-xl-4">
      <c-form action="/" method="POST" data={finalData} submitLabel="Crear nueva contraseña"></c-form>
    </div>
    <div class="u-col-4 u-col-md-2 u-col-lg-3 u-col-xl-4"></div>
  </div>
</section>