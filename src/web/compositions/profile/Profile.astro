---
import AppMenu from '@web/components/AppMenu.astro'
const { id, data } = Astro.props

const finalData = JSON.stringify(data)
---

<section class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <div class="u-grid u-padding--vertical--m">
      <div class="u-flex u-flex--align--center u-col-4 u-col-md-9">
        <img src="https://testingbot.com/free-online-tools/random-avatar/160" alt="Avatar" width="160" height="160" class="u-border--radius--rounded u-border--primary">
        <div class="u-padding--horizontal--l">
          <p class="u-text--xxl u-color--text-light u-margin--none">Daniel Fernández Rey</p>
          <p class="u-text--m u-color--text-light u-margin--none"><e-icon icon="location"></e-icon> Madrid, España</p>
        </div>
      </div>
      <div class="u-flex u-flex--align--center u-flex--justify--end u-col-4 u-col-md-3">
        <e-modal-trigger class="u-margin--right--s" modal="modal">
          <e-button color="dark" title="Cerrar sesión">
            <e-icon icon="logout" size="m"></e-icon>
          </e-button>
          <template>
            <h2 slot="title">Cerrar sesión</h2>
            <p slot="description">¿Estás seguro de que seas cerrar sesión?</p>
            <c-form action="" method="post" data={ finalData } submitLabel="Cerrar sesión" empty></c-form>
          </template>
        </e-modal-trigger>
        <e-button color="dark">Compartir perfil</e-button>
      </div>
      <div class="u-col-4 u-col-md-12 u-col-xl-6">
        <div class="u-grid u-padding--horizontal--none u-margin--bottom--xl">
          <div class="u-col-2 u-col-md-3 u-bg--light u-border--radius--xl u-padding--s u-text--center">
            <p class="u-text--m u-color--text-light u-margin--none">Países</p>
            <p class="u-text--xxl u-color--primary u-margin--none">24</p>
          </div>
          <div class="u-col-2 u-col-md-3 u-bg--light u-border--radius--xl u-padding--s u-text--center">
            <p class="u-text--m u-color--text-light u-margin--none">Viajes</p>
            <p class="u-text--xxl u-color--primary u-margin--none">45</p>
          </div>
          <div class="u-col-2 u-col-md-3 u-bg--light u-border--radius--xl u-padding--s u-text--center">
            <p class="u-text--m u-color--text-light u-margin--none">Kilómetros</p>
            <p class="u-text--xxl u-color--primary u-margin--none">12,5K</p>
          </div>
          <div class="u-col-2 u-col-md-3 u-bg--light u-border--radius--xl u-padding--s u-text--center">
            <p class="u-text--m u-color--text-light u-margin--none">Logros</p>
            <p class="u-text--xxl u-color--primary u-margin--none">14</p>
          </div>
        </div>
        <div class="u-margin--bottom--xl">
          <h2 class="u-text--l u-color--text-light u-margin--top--none u-margin--bottom--m">Biografía</h2>
          <div class="u-bg--light u-border--radius--xl u-padding--l">
            <div class="u-flex u-margin--bottom--l">
              <e-icon icon="route" size="xxl"></e-icon>
              <div>
                <p class="u-text--l u-color--text-light u-margin--none">Buscador de aventuras</p>
                <p class="u-text--m u-color--gray u-margin--none">Progerioso hasta el final</p>
              </div>
            </div>
            <p class="u-text--l u-color--text-light u-margin--none">Lorem ipsum dolor sit amet consectetur adipisicing elit. Aut voluptatibus porro, similique architecto dolor iure nostrum enim ducimus hic corporis, sapiente asperiores ullam, aspernatur accusamus praesentium facilis adipisci. Accusamus, quisquam.</p>
          </div>
        </div>
        <div class="u-flex u-flex--align--center u-flex--justify--between u-margin--bottom--m">
          <h2 class="u-text--l u-color--text-light u-margin--none">Logros</h2>
          <a class="u-link" href="#">Ver todos</a>
        </div>
        <div class="u-flex u-flex--justify--evenly u-flex--gap--l u-bg--light u-border--radius--xl u-padding--l u-text--center">
          <e-achievement icon="diamond" actual="1" total="1" color="white">
            <p slot="title">Pionero</p>
            <p slot="text">Completado</p>
          </e-achievement>
          <e-achievement icon="landscape" actual="12" total="15" color="brown">
            <p slot="title">Rey de la montaña</p>
            <p slot="text">Picos</p>
          </e-achievement>
          <e-achievement icon="flight-takeoff" actual="9" total="15" color="yellow">
            <p slot="title">Viajero frecuente</p>
            <p slot="text">Vuelos</p>
          </e-achievement>
          <e-achievement icon="bubbles" actual="2" total="15" color="blue">
            <p slot="title">Buceador marino</p>
            <p slot="text">Inmersiones</p>
          </e-achievement>
        </div>
      </div>
      <div class="u-col-4 u-col-md-12 u-col-xl-6">
        <div class="u-margin--bottom--xl">
          <div class="u-flex u-flex--align--center u-flex--justify--between u-margin--bottom--m">
            <h2 class="u-text--l u-color--text-light u-margin--none">Últimos viajes</h2>
            <a class="u-link" href="#">Ver todos</a>
          </div>
          <a href="#" class="u-link--no-underline">
            <c-card-progress animated class="u-margin--bottom--s" progress="65">
              <img slot="image" src="https://dynamic-media.tacdn.com/media/photo-o/30/4c/52/8e/caption.jpg?w=2400&h=-1&s=1" alt="Imagen sobre Tailandia" width="80" height="80" />
              <p slot="title">Tailandia</p>
              <p slot="text"><e-icon icon="calendar" size="m"></e-icon> 12 May - 29 May</p>
              <p slot="status">Activo</p>
            </c-card-progress>
          </a>
          <a href="#" class="u-link--no-underline">
            <c-card-progress animated class="u-margin--bottom--s" progress="100">
              <img slot="image" src="https://www.travual.com/userfiles/fotos/monument-valley_4869_l.jpg" alt="Imagen sobre West Coast" width="80" height="80" />
              <p slot="title">West Coast</p>
              <p slot="text"><e-icon icon="calendar" size="m"></e-icon> 2 Ago - 18 Ago</p>
              <p slot="status">Completado</p>
            </c-card-progress>
          </a>
          <a href="#" class="u-link--no-underline">
            <c-card-progress animated class="u-margin--bottom--s" progress="100">
              <img slot="image" src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Machu_Picchu%2C_Peru_%282018%29.jpg/1280px-Machu_Picchu%2C_Peru_%282018%29.jpg" alt="Imagen sobre Perú" width="80" height="80" />
              <p slot="title">Perú</p>
              <p slot="text"><e-icon icon="calendar" size="m"></e-icon> 2 Ago - 18 Ago</p>
              <p slot="status">Completado</p>
            </c-card-progress>
          </a>
        </div>
        <h2 class="u-text--l u-color--text-light u-margin--top--none u-margin--bottom--m">Ranking</h2>
        <ul class="u-bg--light u-border--radius--xl u-padding--s u-list--reset">
          <li class="u-flex u-flex--align--center u-margin--bottom--s u-padding--s u-border--radius--xl u-bg--primary-overlay u-border--primary">
            <p class="u-text--xl u-color--text-light u-margin--vertical--none u-margin--right--m">1</p>
            <img class="u-margin--right--s u-border--radius--rounded u-border--primary" src="https://testingbot.com/free-online-tools/random-avatar/40" alt="Imagen sobre Tailandia" width="40" height="40" />
            <div>
              <p class="u-text--m u-color--text-light u-margin--none">Víctor Martín Rodríguez</p>
              <p class="u-text--s u-color--gray u-margin--none">15.000 pts</p>
            </div>
          </li>
          <li class="u-flex u-flex--align--center u-margin--bottom--s u-padding--s u-border--radius--xl">
            <p class="u-text--xl u-color--text-light u-margin--vertical--none u-margin--right--m">2</p>
            <img class="u-margin--right--s u-border--radius--rounded u-border--primary" src="https://testingbot.com/free-online-tools/random-avatar/40" alt="Imagen sobre Tailandia" width="40" height="40" />
            <div>
              <p class="u-text--m u-color--text-light u-margin--none">Daniel Fernández Rey</p>
              <p class="u-text--s u-color--gray u-margin--none">14.800 pts</p>
            </div>
          </li>
          <li class="u-flex u-flex--align--center u-margin--bottom--s u-padding--s u-border--radius--xl">
            <p class="u-text--xl u-color--text-light u-margin--vertical--none u-margin--right--m">3</p>
            <img class="u-margin--right--s u-border--radius--rounded u-border--primary" src="https://testingbot.com/free-online-tools/random-avatar/40" alt="Imagen sobre Tailandia" width="40" height="40" />
            <div>
              <p class="u-text--m u-color--text-light u-margin--none">Alberto Fernández Rey</p>
              <p class="u-text--s u-color--gray u-margin--none">12.000 pts</p>
            </div>
          </li>
          <li class="u-flex u-flex--align--center u-margin--bottom--s u-padding--s u-border--radius--xl">
            <p class="u-text--xl u-color--text-light u-margin--vertical--none u-margin--right--m">4</p>
            <img class="u-margin--right--s u-border--radius--rounded u-border--primary" src="https://testingbot.com/free-online-tools/random-avatar/40" alt="Imagen sobre Tailandia" width="40" height="40" />
            <div>
              <p class="u-text--m u-color--text-light u-margin--none">José Manuel Rodríguez</p>
              <p class="u-text--s u-color--gray u-margin--none">8.500 pts</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
<c-modal id="modal" close="Cerrar"></c-modal>
