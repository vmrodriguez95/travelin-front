---
import AppMenu from '@web/components/AppMenu.astro'
const { id } = Astro.props
---

<section id={id} class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <c-header heading="Travels" subheading="" url="#" bg=""></c-header>
    <section class="u-grid">
      <div class="u-col-2 u-col-md-6">
        <p class="u-text--l u-color--text-light">179 Viajes</p>
      </div>
      <div class="u-col-2 u-col-md-6 u-text--right">
        <a href="#">
          <e-button>
            Añadir viaje
          </e-button>
        </a>
      </div>
      <div class="u-col-4 u-col-md-6 u-col-lg-4 u-col-xl-3">
        <a href="#">
          <c-card-image
            image="https://loremflickr.com/800/600/japan"
            name="Japón"
            start="28-10-2025"
            end="12-11-2025"
          ></c-card-image>
        </a>
      </div>
      <div class="u-col-4 u-col-md-6 u-col-lg-4 u-col-xl-3">
