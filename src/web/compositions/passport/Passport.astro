---
import AppMenu from '@web/components/AppMenu.astro'

interface GlobeFeature {
  type: 'Feature'
  properties: Record<string, unknown>
  geometry: {
    type: string
    coordinates: unknown
  }
}

interface GlobeFeatureCollection {
  type: 'FeatureCollection'
  features: GlobeFeature[]
}

const countriesGlob = import.meta.glob('../../../data/globe.json', { eager: true })
const data = (Object.values(countriesGlob)[0] as { default: GlobeFeatureCollection })?.default
const countries = JSON.stringify(data.features)

const countryNames = JSON.stringify(['ES', 'AL', 'CO', 'JP', 'BR'])
---

<section class="u-grid-main u-bg--dark" data-component>
  <aside class="u-grid-main--sidebar">
    <AppMenu />
  </aside>
  <div class="u-grid-main--main u-padding--none">
    <c-header heading="Pasaporte" url="#"></c-header>
    <div class="u-grid ti-passport">
      <div class="u-col-4 u-col-md-12 u-col-xl-6 u-order--xl--2 ti-passport__summary">
        <c-globe data={countries} countries={countryNames} errorMessage="Ocurrió un error al cargar el mapa interactivo. Por favor, compruebe en los ajustes de su navegador que WEbGL o la aceleración por hardware está habilitado para poder verlo. Si está desactívelo, reinicie el navegador y vuelva a activarlo."></c-globe>
        <div class="ti-passport__stats">
          <div class="ti-passport__stats__column">
            <p class="ti-passport__stats__title">Países</p>
            <p class="ti-passport__stats__text">5</p>
          </div>
          <div class="ti-passport__stats__column u-text--center">
            <p class="ti-passport__stats__title">Viajes</p>
            <p class="ti-passport__stats__text">10</p>
          </div>
          <div class="ti-passport__stats__column u-text--right">
            <p class="ti-passport__stats__title">Pois</p>
            <p class="ti-passport__stats__text">54</p>
          </div>
          <div class="ti-passport__stats__action">
            <e-button size="full">Compartir</e-button>
          </div>
        </div>
      </div>
      <div class="u-col-4 u-col-md-12 u-col-xl-6 u-order--xl--1 ti-passport__trips">
