---
import AppMenu from '@web/components/AppMenu.astro'
import { withFormA11yDefaults } from '@web/utils/form.server.ts'
const { id, data } = Astro.props

let finalData = withFormA11yDefaults(data)

finalData = JSON.stringify(finalData)
---

<section id={id} class="u-grid-main u-bg--dark" data-component>
  <div class="u-grid-main--sidebar">
    <AppMenu />
  </div>
  <div class="u-grid-main--main">
    <c-header heading="Añadir recordatorio" subheading="" url="#" bg=""></c-header>
    <div class="u-grid">
      <div class="u-col-4 u-col-md-2"></div>
      <div class="u-col-4 u-col-md-8">
        <c-form action="/" method="POST" data={finalData} submitLabel="Añadir recordatorio" enctype="multipart/form-data"></c-form>
      </div>
      <div class="u-col-4 u-col-md-2"></div>
    </div>
  </div>
</section>
