---
import '../elements'
import { elements } from '../registry/elements'
import { components } from '../registry/components'
import { getIcon } from '../registry/icons'

import IconsIcon from '../assets/icons/icons.svg'

// Styles
import '../styles/design-system/index.scss'
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Travel In - Design System</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="module" src="/src/elements/index.ts"></script>
  </head>
  <body class="ti-layout">
    <aside class="ti-layout__aside">
      <a class="ti-layout__logo" href="/">
        <img class="ti-layout__image" src="/images/logo.png" alt="Travel In Logo" width="32" height="38" />
        <span class="ti-text--l">Travel In</span>
      </a>
      <nav>
        <h2 class="ti-layout__title ti-text--xl">Foundations</h2>
        <ul class="ti-layout__list">
          <li class="ti-layout__item">
            <a class="ti-layout__link" href="/foundations/introduction">
              <span class="ti-icon" set:html={getIcon('rocket')}></span>
              <span>Introducción</span>
            </a>
          </li>
          <li class="ti-layout__item">
            <a class="ti-layout__link" href="/foundations/colors">
              <span class="ti-icon" set:html={getIcon('palette')}></span>
              <span>Colores</span>
            </a>
          </li>
          <li class="ti-layout__item">
            <a class="ti-layout__link" href="/foundations/typography">
              <span class="ti-icon" set:html={getIcon('letter')}></span>
              <span>Tipografía</span>
            </a>
          </li>
          <li class="ti-layout__item">
            <a class="ti-layout__link" href="/foundations/icons">
              <span class="ti-icon" set:html={getIcon('icons')}></span>
              <span>Iconos</span>
            </a>
          </li>
        </ul>
        <h2 class="ti-layout__title ti-text--xl">Elementos</h2>
        <ul class="ti-layout__list">
          {elements.map((e) => (
            <li class="ti-layout__item">
              <a class="ti-layout__link" href={`/elements/${e.meta.tag}`}>
                <span class="ti-icon" set:html={getIcon(e.meta.icon)}></span>
                <span>{e.meta.name}</span>
              </a>
            </li>
          ))}
        </ul>
        <h2 class="ti-layout__title ti-text--xl">Componentes</h2>
        <ul class="ti-layout__list">
          {components.map((c) => (
            <li class="ti-layout__item">
              <a class="ti-layout__link" href={`/components/${c.meta.tag}`}>
                <span class="ti-icon" set:html={getIcon(c.meta.icon)}></span>
                <span>{c.meta.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
    <header class="ti-layout__header"></header>
    <main class="ti-layout__main">
      <slot />
    </main>
  </body>
</html>