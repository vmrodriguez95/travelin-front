{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["DOM", "ES2022"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["src/web/*"],
      "@common/*": ["src/common/*"],
      "@ds/*": ["src/design-system/*"]
    }
  }
}
